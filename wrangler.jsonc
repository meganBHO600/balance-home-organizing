{
  // Static site plus a small Worker that handles the two contact forms.
  // site/ is prebuilt HTML committed to the repo — nothing to build or install.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balance-home-organizing",
  "main": "src/index.js",
  "compatibility_date": "2025-05-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Blog posts live here so Megan can publish without a git push or rebuild.
  // database_id is filled in after creating the database in the dashboard.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "balance-home-organizing",
      "database_id": "1a24c7dd-3b34-4f13-bc16-113f54f9c78e"
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Without this, Cloudflare serves a matching static asset and never invokes
    // the Worker — so the www -> apex redirect in src/index.js never ran for
    // page requests, only for /api/*. With it, the Worker sees every request
    // and falls through to env.ASSETS.fetch() for anything it does not handle.
    "run_worker_first": true
  }
}
